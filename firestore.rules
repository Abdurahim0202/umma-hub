rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Backstop only — catches explicit profanity/slurs by direct text match.
    // This is NOT a substitute for the app's Groq-based moderation check
    // (app/api/moderate), which also catches hate speech, harassment, and
    // coded language that no regex can reliably match. Rules can't call an
    // external API, so this list is deliberately small and literal.
    function hasBlockedTerm(text) {
      return text.lower().matches('.*\\b(fuck|fucking|fucker|motherfucker|shit|bullshit|asshole|bitch|bastard|cunt|dick|pussy|cock|slut|whore|nigger|nigga|faggot|fag|retard|retarded|kike|spic|chink|gook|wetback|towelhead|raghead|paki|tranny|dyke)\\b.*');
    }

    function isValidPost() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'body', 'category', 'createdAt'])
          && data.title is string && data.title.size() >= 3 && data.title.size() <= 300
          && data.body  is string && data.body.size()  >= 1 && data.body.size()  <= 10000
          && data.userId == request.auth.uid
          && !hasBlockedTerm(data.title) && !hasBlockedTerm(data.body);
    }

    function isValidComment() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'body', 'createdAt'])
          && data.body is string && data.body.size() >= 1 && data.body.size() <= 5000
          && data.userId == request.auth.uid
          && !hasBlockedTerm(data.body);
    }

    // ── PROFILES ─────────────────────────────────────────────────
    // Anyone signed in can read any profile.
    // Users can only write their own profile.

    match /profiles/{userId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['email', 'displayName', 'role'])
                    && request.resource.data.role == 'member';
      allow update: if isOwner(userId)
                    // Prevent role escalation
                    && (!request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role == resource.data.role);
      allow delete: if false; // Never delete profiles via client
    }

    // ── POSTS ─────────────────────────────────────────────────────
    // Anyone can read posts. Only signed-in users can create.
    // Only the author can update or delete their own post.

    match /posts/{postId} {
      allow read: if true; // Public
      allow create: if isSignedIn() && isValidPost();
      allow update: if isOwner(resource.data.userId)
                    // Allow incrementing voteScore / commentCount by the system
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['voteScore', 'commentCount', 'updatedAt']));
      allow delete: if isOwner(resource.data.userId);

      // ── COMMENTS (sub-collection of posts) ────────────────────
      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isSignedIn() && isValidComment();
        allow update: if isOwner(resource.data.userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt']);
        allow delete: if isOwner(resource.data.userId);
      }
    }

    // ── VOTES ─────────────────────────────────────────────────────
    // Vote documents are keyed {userId}_{postId} — one vote per user per post.
    // Only the owning user can write their vote.

    match /votes/{voteId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.value in [1, -1];
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.value in [1, -1];
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── PUBLIC DATA (mosques, events, resources) ──────────────────
    // These are read-only from the client.
    // Data is managed server-side / seeded statically in the app.

    match /mosques/{document=**}   { allow read: if true; allow write: if false; }
    match /events/{document=**}    { allow read: if true; allow write: if false; }
    match /resources/{document=**} { allow read: if true; allow write: if false; }

    // ── DENY ALL ELSE ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
